rules_version = '2';

// 実演用のルール：memos だけを、期限まで誰でも読み書きできる（コンソールの「テストモード」と同じ考え方）。
// 期限の日付は講義の日に合わせて書き換える。撮影や講義が終わったら、下の if を false にして閉じる
service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 19);
    }
  }
}
