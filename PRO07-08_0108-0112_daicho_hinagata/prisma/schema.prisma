// 案件台帳のデータの形（1/8 の時点：問い合わせ・案件・日報）

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 案件の状態（6 つから 1 つ）
enum Status {
  SURVEY // 現地調査
  ESTIMATING // 見積中
  CONTRACTED // 契約
  IN_PROGRESS // 工事中
  DONE // 完了
  INVOICED // 請求済
}

/// 問い合わせ
model Inquiry {
  id        Int       @id @default(autoincrement())
  name      String // お客さんの名前
  body      String // 問い合わせの中身
  createdAt DateTime  @default(now())
  projects  Project[]
}

/// 案件
model Project {
  id        Int      @id @default(autoincrement())
  title     String // 件名
  status    Status   @default(SURVEY)
  amount    Int? // 見積金額
  assignee  String? // 担当者（名前の文字）
  inquiryId Int? // 問い合わせ番号
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id])
  updatedAt DateTime @updatedAt
  reports   Report[] // 日報（たくさん）
}

/// 日報
model Report {
  id        Int      @id @default(autoincrement())
  date      DateTime // 作業した日
  workers   Int // 人数
  note      String // 内容
  projectId Int // 案件番号
  project   Project  @relation(fields: [projectId], references: [id])
}
