# .env にコピーして、値を入れる（.env はリポジトリに入れない）
DATABASE_URL="postgresql://ユーザー:パスワード@ホスト:5432/データベース名"
BETTER_AUTH_SECRET="32 文字以上のランダムな文字（openssl rand -base64 32 などで作る）"
BETTER_AUTH_URL="http://localhost:3000"
# 依頼 1 の直し（受け口で金額を外す）。off にすると「画面で隠しただけ」の版になる（1/12・1/15 の実演用）
AMOUNT_GUARD="on"
# 日報の受け口で「自分の日報か」を確かめる。off にすると ID の差し替えで他人の日報が開く（1/12 の実演用）
REPORT_GUARD="on"
# 日報の要約（依頼 3）の鍵。サーバーだけで読む（NEXT_PUBLIC_ を付けない）。
# AI の頼み先が決まるまでは「仮の要約」なので、手元では何か文字が入っていれば動く。公開先で入れ忘れると 500（2/5 の実演）
AI_API_KEY="ここに鍵"
# docker compose で動かすときだけ使う：データベースの箱のパスワード（compose.yaml が読む）
DB_PASSWORD="ここにパスワード"
